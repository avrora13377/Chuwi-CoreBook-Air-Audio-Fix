[Unit]
Description=CoreBook Air Plus speakers: keep I2S DACs bound to the live PCM stream
After=corebook-speakers.service
Requires=corebook-speakers.service
PartOf=corebook-speakers.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-/etc/default/corebook-audio
ExecStart=/usr/bin/python3 /usr/local/lib/corebook-audio/maintain-stream.py 0.2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
