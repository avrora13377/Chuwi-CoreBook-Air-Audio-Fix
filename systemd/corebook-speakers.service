[Unit]
Description=CoreBook Air Plus internal speaker restore (SN6180 vendor PA bridge)
Documentation=https://github.com/avrora13377/corebook-air-plus-audio-fix
After=multi-user.target sound.target
Wants=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/corebook-speakers.sh
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
